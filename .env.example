# Local demo only. Keep real credentials out of Git.
HOST=127.0.0.1
PORT=3000
ADMIN_TOKEN=replace-with-a-long-random-value
# PostgreSQL mode uses individual expiring staff tokens, never ADMIN_TOKEN.
PERSISTENCE=memory
# Set both values for local PostgreSQL; keep them out of Git.
LOCAL_POSTGRES_PASSWORD=
DATABASE_URL=
# Separate database/schema created by integration tests; explicit opt-in required.
TEST_DATABASE_URL=
# console: browser simulation. cloud: replies to permitted Meta test recipients.
WHATSAPP_TRANSPORT=console
POS_PROVIDER=toteat
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set an explicitly supported Graph version from your Meta app dashboard.
WHATSAPP_GRAPH_VERSION=
# POS and payment are simulated in this initial implementation in BOTH modes.

# Optional PostgreSQL-only integration sandbox; never production merchant credentials.
WEBPAY_SANDBOX_ENABLED=false
WEBPAY_SANDBOX_COMMERCE_CODE=
WEBPAY_SANDBOX_API_KEY=
# Approved public HTTPS origin, ending in /sandbox/return.
WEBPAY_SANDBOX_RETURN_URL=
