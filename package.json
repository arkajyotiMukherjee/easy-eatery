{
  "name": "easy-eatery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=.env apps/server/src/index.ts",
    "start": "node --import tsx --env-file-if-exists=.env apps/server/src/index.ts",
    "check": "tsc --noEmit && node --check apps/server/public/app.js && node --check apps/server/public/i18n.js",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": { "fastify": "^5.6.1" },
  "devDependencies": { "@types/node": "^24.0.0", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
